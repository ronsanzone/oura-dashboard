{
  "name": "@oura/dashboard-worker",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build:ui": "pnpm --filter @oura/dashboard-ui build",
    "build:worker": "tsc -p tsconfig.build.json",
    "dev": "pnpm run build:ui && pnpm run build:worker && wrangler dev --local --port 8787",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "deploy:dry-run:production": "pnpm run build:ui && pnpm run build:worker && wrangler deploy --env production --strict --dry-run"
  },
  "dependencies": {
    "@oura/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.17",
    "@cloudflare/workers-types": "^5.20260718.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
