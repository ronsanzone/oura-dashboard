{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oura-observatory-local",
  "main": "dist/index.js",
  "upload_source_maps": false,
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "../dashboard-ui/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "vars": {
    "JEV_ENABLED": "false",
    "DEPLOYMENT_MODE": "local",
    "OURA_REDIRECT_URI": "http://localhost:8787/oauth/callback",
    "DASHBOARD_HOSTNAME": "localhost",
    "WEBHOOK_HOSTNAME": "oura-hooks.localhost",
    "ACCESS_TEAM_DOMAIN": "https://ronsanzone.cloudflareaccess.com",
    "ACCESS_AUD": "local-development",
    "ACCESS_ALLOWED_EMAIL": "local-development"
  },
  "ratelimits": [
    {
      "name": "JEV_RATE_LIMITER",
      "namespace_id": "84217002",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "WEBHOOK_RATE_LIMITER",
      "namespace_id": "84217001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oura-observatory-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../migrations"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "env": {
    "production": {
      "name": "oura-observatory",
      "workers_dev": false,
      "preview_urls": false,
      "ai": { "binding": "AI" },
      "vars": {
        "JEV_ENABLED": "true",
        "DEPLOYMENT_MODE": "production",
        "OURA_REDIRECT_URI": "https://oura.ronsanzone.dev/oauth/callback",
        "DASHBOARD_HOSTNAME": "oura.ronsanzone.dev",
        "WEBHOOK_HOSTNAME": "oura-hooks.ronsanzone.dev",
        "ACCESS_TEAM_DOMAIN": "https://ronsanzone.cloudflareaccess.com",
        "ACCESS_AUD": "38b7d91be183fb3cec2f8a12f5096fc8e6314d8e1c7c7ddda467640fda0df2fe",
        "ACCESS_ALLOWED_EMAIL": "ron.sanzone1@gmail.com"
      },
      "ratelimits": [
        {
          "name": "JEV_RATE_LIMITER",
          "namespace_id": "84217002",
          "simple": { "limit": 6, "period": 60 }
        },
        {
          "name": "WEBHOOK_RATE_LIMITER",
          "namespace_id": "84217001",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "oura-observatory",
          "database_id": "d7761828-bc02-4f02-85ae-96d47eed6c15",
          "migrations_dir": "../../migrations"
        }
      ],
      "triggers": {
        "crons": ["17 3 * * *"]
      },
      "routes": [
        {
          "pattern": "oura.ronsanzone.dev",
          "custom_domain": true
        },
        {
          "pattern": "oura-hooks.ronsanzone.dev",
          "custom_domain": true
        }
      ]
    }
  }
}
